# ── 必填 ──────────────────────────────────────────────────────────────────────
API_FOOTBALL_KEY=               # https://www.api-football.com 获取
TELEGRAM_BOT_TOKEN=             # @BotFather 创建机器人
LLM_API_KEY=                    # LLM 服务 API Key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Telegram 配置 ─────────────────────────────────────────────────────────────
ALLOWED_TELEGRAM_CHAT_IDS=      # 允许使用的 chat_id，逗号分隔（留空=需 /start 绑定）
TELEGRAM_BIND_CODE=             # 自定义绑定验证码（留空则自动生成）
POLL_TIMEOUT_SECONDS=30

# ── LLM 配置 ──────────────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=180

# ── API Football 配置 ─────────────────────────────────────────────────────────
API_FOOTBALL_MIN_INTERVAL_SECONDS=0.5
API_FOOTBALL_MAX_RETRIES=3

# ── Skill 路径 ────────────────────────────────────────────────────────────────
SKILL_PATH=/opt/football-bot/skill/SKILL.md

# ── Exa 搜索（可选，用于赛前情报搜索）────────────────────────────────────────
EXA_API_KEY=                    # https://exa.ai 获取
EXA_BASE_URL=https://api.exa.ai
EXA_NUM_RESULTS=5
EXA_FETCH_LIMIT=4
EXA_TEXT_MAX_CHARACTERS=3500
EXA_TIMEOUT_SECONDS=45
EXA_MAX_RETRIES=2
EXA_MIN_INTERVAL_SECONDS=0.25

# ── Tavily 搜索（可选，与 Exa 并行搜索）──────────────────────────────────────
TAVILY_API_KEY=                 # https://tavily.com 获取

# ── 竞彩代理（可选）─────────────────────────────────────────────────────────
# sporttery.cn 仅允许大陆IP访问，境外服务器需配置大陆代理
# 配置方式一：HTTP 代理（如本机 mihomo/clash）
# JINGCAI_PROXY=http://127.0.0.1:7890
# 配置方式二：留空，由大陆机器运行 jingcai_relay.py 上传缓存
JINGCAI_PROXY=

# ── 日志 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
